include=~/.config/mako/colors.conf

sort=-time
layer=overlay
anchor=top-center
width=300
height=110
border-size=2
border-radius=15
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=monospace 14

[urgency=normal]
default-timeout=5000

[urgency=high]
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

# uair pomodoro notifications, sent by ~/.config/uair/blink-notify.sh which
# alternates between these two categories to make the popup blink.
# Colors live in colors.conf (generated by matugen).
[category=uair]
default-timeout=10000
border-size=4

[category=uair-blink]
default-timeout=10000
border-size=4
